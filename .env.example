BIND_ADDRESS=127.0.0.1
PORT=5081
# Set to the external HTTPS origin before enabling Google login in production.
PUBLIC_URL=http://localhost:5081
# Add this deployment's exact /auth/callback URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit callback; otherwise PUBLIC_URL + /auth/callback is used.
GOOGLE_REDIRECT_URI=
# Leave empty to generate a persistent private key in the /data volume.
FLASK_SECRET_KEY=
# Set 1 only when the app is behind exactly one trusted reverse proxy.
TRUST_PROXY=0
# Optional upstream provider credentials; no payment/unlock feature in this app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
YOUTUBE_API_KEY=
# Optional comma-separated verified Google emails allowed to edit the guide.
ADMIN_EMAILS=
